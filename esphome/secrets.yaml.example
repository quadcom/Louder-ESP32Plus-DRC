# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
# The placeholders below are enough for `esphome config` to validate, but not
# to flash - the wifi password must be at least 8 characters for a real join.
esphome_ota_password: replace-me
esphome_wifi_ssid: replace-me
esphome_wifi_password: replace-me-min-8-chars
